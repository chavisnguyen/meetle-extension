{
  "manifest_version": 3,
  "name": "Meetle Recorder",
  "version": "0.1.0",
  "description": "Records the Google Meet tab (video + both voices) and uploads it to Google Drive.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "identity", "offscreen", "storage", "tabCapture", "tabs"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.englishmaile.com/*",
    "https://www.googleapis.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Meetle Recorder",
    "default_popup": "popup.html"
  },
  "key": "",
  "oauth2": {
    "client_id": "PASTE-CLIENT-ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/userinfo.email"]
  }
}
