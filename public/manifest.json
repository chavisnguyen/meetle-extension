{
  "manifest_version": 3,
  "name": "Meetle Recorder",
  "version": "0.3.0",
  "description": "Records the Google Meet tab (video + both voices) and uploads it to Google Drive.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "identity", "offscreen", "storage", "tabCapture", "tabs"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.englishmaile.com/*",
    "https://www.googleapis.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": {
    "default_icon": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
    "default_title": "Meetle Recorder",
    "default_popup": "popup.html"
  },
  "key": ""
}
